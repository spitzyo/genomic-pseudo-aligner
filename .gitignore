# Ignore system cache files
__pycache__/
*.DS_Store

# Ignore large input data files
*.fa
*.fasta
*.fq
*.fastq
*.gz

# Allow the integration-test data files to be tracked
!test_data/reference_genomes.fa
!test_data/reads.fastq

# Ignore generated output files (we don't want to save these results)
*.aln
*.kdb
*.json

# Ignore virtual environment (if you have one)
.venv/
env/